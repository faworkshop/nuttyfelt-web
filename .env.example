# Neon Postgres
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Resend
RESEND_API_KEY=
NOTIFY_EMAIL=faworkshop18@gmail.com
# After Resend shows nuttyfelt.com Verified, use hello@nuttyfelt.com.
# Until then: onboarding@resend.dev (only delivers to your Resend account email)
EMAIL_FROM=hello@nuttyfelt.com

# Public site origin (canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://nuttyfelt-web-production.up.railway.app

# Clerk (admin portal) — keys from Clerk dashboard / `clerk init`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# Optional later (after admin portal)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=
